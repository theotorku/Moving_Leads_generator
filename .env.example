# Environment Variables Template
# Copy this to .env and fill in your actual values

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# Stripe Configuration (for monetization - optional)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
# Webhook signing secret (Stripe Dashboard > Developers > Webhooks). Required to
# verify and process events at POST /stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret-here
# When true, trust webhook-synced subscription state and skip the per-read Stripe
# API call (recommended once the webhook endpoint is live).
RECONCILE_VIA_WEBHOOK=false

# Admin Dashboard Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-to-secure-password

# CORS Configuration (comma-separated list of allowed origins)
# Default: http://localhost:5173 (React dev server)
# For production, add your deployed frontend URL
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

